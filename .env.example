# Mia API Configuration
MIA_API_URL=https://api.miaai.me
MIA_SITE_ID=your-site-id-here
MIA_VERIFY_SSL=true
MIA_DEBUG=false

# Admin System Configuration
ADMIN_ADDRESS=systemAdmin/

# Session Configuration
# For production, use remote memcached: 10.0.11.6:11211
# For local development in Docker, use: memcached:11211
# For local development without Docker, use: localhost:11211
MEMCACHED_HOST=memcached
MEMCACHED_PORT=11211

# Development/Local API Example:
# MIA_API_URL=http://localhost:8080
# MIA_SITE_ID=9963a3ee-5955-4ba0-acda-84efb3494b36
# MIA_VERIFY_SSL=false
# MIA_DEBUG=true