# Mia API Configuration
MIA_API_URL=https://api.miaai.me
MIA_SITE_ID=your-site-id-here
MIA_VERIFY_SSL=true
MIA_DEBUG=false

# Admin System Configuration
ADMIN_ADDRESS=systemAdmin/

# Caching Configuration
CACHE_ENABLED=true
CACHE_TTL=300

# Memcached Configuration
MEMCACHED_HOST=localhost
MEMCACHED_PORT=11211

# Development/Local API Example:
# MIA_API_URL=http://localhost:8080
# MIA_SITE_ID=9963a3ee-5955-4ba0-acda-84efb3494b36
# MIA_VERIFY_SSL=false
# MIA_DEBUG=true
# CACHE_ENABLED=false