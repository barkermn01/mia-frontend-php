# Mia API Configuration
MIA_API_URL=https://api.miaai.me
MIA_SITE_ID=your-site-id-here
MIA_VERIFY_SSL=true
MIA_DEBUG=false

# Admin System Configuration
ADMIN_ADDRESS=systemAdmin/

# Session Configuration
# DO NOT set MEMCACHED_HOST or MEMCACHED_PORT here!
# These must be set as actual environment variables:
# - Docker: Set in docker-compose.yml (memcached:11211)
# - Production: Set in CloudFormation (10.0.11.6:11211)
# - Local: Defaults to localhost:11211 when not set

# Development/Local API Example:
# MIA_API_URL=http://localhost:8080
# MIA_SITE_ID=9963a3ee-5955-4ba0-acda-84efb3494b36
# MIA_VERIFY_SSL=false
# MIA_DEBUG=true