<script src="/js/configurator.js"></script>
<script>
(function() {
    const container = document.getElementById('home-configurator');
    const makeSelect = container.querySelector('[data-cfg="make"]');
    const modelSelect = container.querySelector('[data-cfg="model"]');
    const variantSelect = container.querySelector('[data-cfg="variant"]');
    const goBtn = document.getElementById('cfg-go-btn');

    function slugify(s) { return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''); }

    function updateGoBtn() {
        const make = makeSelect.value;
        const model = modelSelect.value;
        const variant = variantSelect.value;
        let url = '/systems';
        if (make) url += '/' + encodeURIComponent(make);
        if (model) url += '/' + encodeURIComponent(model);
        if (variant) url += '/' + encodeURIComponent(slugify(variant));
        goBtn.href = url;
        if (make) {
            goBtn.classList.remove('opacity-50', 'pointer-events-none');
        } else {
            goBtn.classList.add('opacity-50', 'pointer-events-none');
        }
    }

    makeSelect.addEventListener('change', async function() {
        modelSelect.innerHTML = '<option value="">-- Select Model --</option>';
        variantSelect.innerHTML = '<option value="">-- Select Variant --</option>';
        modelSelect.disabled = true;
        variantSelect.disabled = true;
        if (this.value) {
            const res = await fetch('/api/configurator/options?type=models&make=' + encodeURIComponent(this.value));
            const data = await res.json();
            (data.items || []).forEach(m => { const o = document.createElement('option'); o.value = m; o.textContent = m; modelSelect.appendChild(o); });
            modelSelect.disabled = false;
        }
        updateGoBtn();
    });

    modelSelect.addEventListener('change', async function() {
        variantSelect.innerHTML = '<option value="">-- Select Variant --</option>';
        variantSelect.disabled = true;
        if (this.value) {
            const res = await fetch('/api/configurator/options?type=variants&make=' + encodeURIComponent(makeSelect.value) + '&model=' + encodeURIComponent(this.value));
            const data = await res.json();
            Object.keys(data.items || {}).forEach(v => { const o = document.createElement('option'); o.value = v; o.textContent = v; variantSelect.appendChild(o); });
            variantSelect.disabled = false;
        }
        updateGoBtn();
    });

    variantSelect.addEventListener('change', updateGoBtn);
})();
</script>
<?php endif; ?>

