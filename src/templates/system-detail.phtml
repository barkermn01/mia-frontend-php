<script>
async function addAllSystemParts() {
    const btn = document.getElementById('add-all-btn');
    if (!btn) return;
    const originalText = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Adding all parts...';
    btn.disabled = true;
    const parts = <?= json_encode(array_map(function($p) { return ['sku' => $p['sku'], 'qty' => 1]; }, array_values($addableParts))) ?>;
    let ok = 0, fail = 0;
    for (const part of parts) {
        try {
            const r = await MiaStore.request('/api/cart/add', { method: 'POST', body: JSON.stringify({ sku: part.sku, qty: part.qty }) });
            if (r.success) { ok++; MiaStore.updateCartCount(r.cartCount); } else { fail++; }
        } catch (e) { fail++; }
    }
    MiaStore.showToast(fail === 0 ? `All ${ok} parts added to basket!` : `${ok} added, ${fail} failed`, fail > 0 ? 'error' : 'success');
    btn.innerHTML = originalText;
    btn.disabled = false;
}
</script>
