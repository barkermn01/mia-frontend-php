<script>
// Initialize the product form with configuration data
document.addEventListener('DOMContentLoaded', function() {
    const formConfig = {
        adminPath: '<?= $adminPath ?>',
        isEdit: <?= $isEdit ? 'true' : 'false' ?>,
        variants: [
            <?php if (($isEdit && !empty($variants)) || (!$isEdit && !empty($variants))): ?>
                <?php foreach ($variants as $variant): ?>
                    {
                        uuid: '<?= addslashes($variant['uuid'] ?? $variant['id'] ?? '') ?>',
                        sku: '<?= addslashes($variant['sku']) ?>',
                        price: <?php
                        $jsPrice = 0;
                        if (isset($variant['price'])) {
                            $price = $variant['price'];
                            if (is_array($price) && isset($price[0]['unit'])) {
                                // Price is array with currency objects: [{"currency": "GBP", "unit": 1999}]
                                $jsPrice = $price[0]['unit'] / 100;
                            } elseif (is_array($price) && isset($price['unit'])) {
                                // Price is object: {"unit": 1999}
                                $jsPrice = $price['unit'] / 100;
                            } elseif (is_numeric($price)) {
                                // Price is simple number
                                if ($isEdit && !isset($error)) {
                                    // In edit mode without error - price is from API in cents/pence
                                    $jsPrice = $price / 100;
                                } else {
                                    // In create mode or error state - price is from form data in pounds/dollars
                                    $jsPrice = $price;
                                }
                            }
                        }
                        echo $jsPrice;
                        ?>,
                        presentableName: '<?= addslashes($variant['presentableName'] ?? '') ?>',
                        attributes: <?= json_encode($variant['attributes'] ?? []) ?>
                    },
                <?php endforeach; ?>
            <?php endif; ?>
        ]
    };
    
    initializeProductForm(formConfig);
});
</script>
