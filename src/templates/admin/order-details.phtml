<script>
function showRefundDialog(orderId) {
    const modalManager = new ModalManager();
    
    // Get order data from the page
    const orderTotal = <?= $order['total'] ?>;
    const orderItems = <?= json_encode($order['items']) ?>;
    const currency = '<?= $order['currency'] ?? 'GBP' ?>';
    const symbol = currency === 'GBP' ? '£' : (currency === 'USD' ? '$' : '€');$' : '€');
    
    // Create modal HTML
    const modal = document.createElement('div');
    modal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 overflow-y-auto';
    modal.innerHTML = `
        <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full p-6 my-8">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Refund Order</h3>
            
            <div class="space-y-4">
                <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                    <p class="text-sm text-yellow-800">
                        <i class="fas fa-exclamation-triangle mr-2"></i>
                        <strong>Warning:</strong> Refunds are processed through Stripe and cannot be undone.
                    </p>
                </div>
                
                <!-- Refund Type Selection -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Refund Type</label>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="radio" name="refund-type" value="full" checked class="mr-2">
                            <span>Full Refund (${symbol}${(orderTotal / 100).toFixed(2)}) - <strong>Cancels order</strong></span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="refund-type" value="partial-amount" class="mr-2">
                            <span>Partial Refund - Specific Amount - <strong>Order remains active</strong></span>
                        </label>
                        <label class="flex items-center">
                            <input type="radio" name="refund-type" value="partial-items" class="mr-2">
                            <span>Partial Refund - Select Items - <strong>Order remains active</strong></span>
                        </label>
                    </div>
                </div>
                
                <!-- Partial Amount Input -->
                <div id="partial-amount-section" class="hidden">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Refund Amount</label>
                    <div class="flex items-center space-x-2">
                        <span class="text-gray-600">${symbol}</span>
                        <input type="number" id="refund-amount" step="0.01" min="0.01" max="${(orderTotal / 100).toFixed(2)}" 
                               placeholder="0.00"
                               class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    <p class="text-xs text-gray-500 mt-1">Maximum: ${symbol}${(orderTotal / 100).toFixed(2)}</p>
                </div>
                
                <!-- Items Selection -->
                <div id="partial-items-section" class="hidden">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Select Items to Refund</label>
                    <div class="border border-gray-300 rounded-lg divide-y max-h-60 overflow-y-auto">
                        ${orderItems.map((item, index) => `
                            <label class="flex items-center p-3 hover:bg-gray-50 cursor-pointer">
                                <input type="checkbox" class="refund-item-checkbox mr-3" data-index="${index}" data-price="${item.price}" data-qty="${item.qty}">
                                <div class="flex-1">
                                    <p class="font-medium text-gray-900">${item.name || item.sku}</p>
                                    <p class="text-sm text-gray-600">Qty: ${item.qty} × ${symbol}${(item.price / 100).toFixed(2)} = ${symbol}${((item.price * item.qty) / 100).toFixed(2)}</p>
                                </div>
                            </label>
                        `).join('')}
                    </div>
                    <p class="text-sm text-gray-700 mt-2">
                        Selected refund amount: <span id="selected-refund-total" class="font-semibold">${symbol}0.00</span>
                    </p>
                </div>
                
                <!-- Refund Reason -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Refund Reason</label>
                    <textarea id="refund-reason" rows="3" 
                              placeholder="Enter reason for refund (optional)"
                              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
                </div>
            </div>
            
            <div class="flex justify-end space-x-3 mt-6">
                <button class="cancel-btn px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
                    Cancel
                </button>
                <button class="confirm-btn px-4 py-2 rounded-lg text-white transition-colors bg-red-600 hover:bg-red-700">
                    <i class="fas fa-ban mr-2"></i>Cancel & Refund Order
                </button>
            </div>
        </div>
    `;
    
    document.body.appendChild(modal);
    
    // Get elements
    const refundTypeRadios = modal.querySelectorAll('input[name="refund-type"]');
    const partialAmountSection = modal.querySelector('#partial-amount-section');
    const partialItemsSection = modal.querySelector('#partial-items-section');
    const refundAmountInput = modal.querySelector('#refund-amount');
    const itemCheckboxes = modal.querySelectorAll('.refund-item-checkbox');
    const selectedTotalSpan = modal.querySelector('#selected-refund-total');
    const confirmBtn = modal.querySelector('.confirm-btn');
    const cancelBtn = modal.querySelector('.cancel-btn');
    
    // Handle refund type change
    refundTypeRadios.forEach(radio => {
        radio.addEventListener('change', (e) => {
            partialAmountSection.classList.add('hidden');
            partialItemsSection.classList.add('hidden');
            
            if (e.target.value === 'partial-amount') {
                partialAmountSection.classList.remove('hidden');
                confirmBtn.innerHTML = '<i class="fas fa-undo mr-2"></i>Process Refund';
            } else if (e.target.value === 'partial-items') {
                partialItemsSection.classList.remove('hidden');
                confirmBtn.innerHTML = '<i class="fas fa-undo mr-2"></i>Process Refund';
            } else {
                // Full refund
                confirmBtn.innerHTML = '<i class="fas fa-ban mr-2"></i>Cancel & Refund Order';
            }
        });
    });
    
    // Handle item checkbox changes
    itemCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', () => {
            let total = 0;
            itemCheckboxes.forEach(cb => {
                if (cb.checked) {
                    const price = parseInt(cb.dataset.price);
                    const qty = parseInt(cb.dataset.qty);
                    total += price * qty;
                }
            });
            selectedTotalSpan.textContent = symbol + (total / 100).toFixed(2);
        });
    });
    
    // Handle confirm
    confirmBtn.addEventListener('click', async () => {
        const refundType = modal.querySelector('input[name="refund-type"]:checked').value;
        const reason = document.getElementById('refund-reason').value.trim() || 'Refund processed by admin';
        
        let refundAmount = 0;
        let endpoint = '';
        let requestData = { orderId: orderId, reason: reason };
        
        if (refundType === 'full') {
            // Full refund - cancel order
            endpoint = '<?= $adminPath ?>/api/orders/refund';
            requestData.type = 'full';
        } else if (refundType === 'partial-amount') {
            // Partial refund with specific amount
            const amountValue = parseFloat(refundAmountInput.value);
            if (!amountValue || amountValue <= 0) {
                const alertManager = new ModalManager();
                alertManager.alert({
                    type: 'error',
                    title: 'Invalid Amount',
                    message: 'Please enter a valid refund amount'
                });
                return;
            }
            if (amountValue > orderTotal / 100) {
                const alertManager = new ModalManager();
                alertManager.alert({
                    type: 'error',
                    title: 'Invalid Amount',
                    message: 'Refund amount cannot exceed order total'
                });
                return;
            }
            refundAmount = Math.round(amountValue * 100);
            endpoint = '<?= $adminPath ?>/api/orders/partial-refund';
            requestData.amount = refundAmount;
        } else if (refundType === 'partial-items') {
            // Partial refund with selected items
            let total = 0;
            const selectedItems = [];
            itemCheckboxes.forEach(cb => {
                if (cb.checked) {
                    const price = parseInt(cb.dataset.price);
                    const qty = parseInt(cb.dataset.qty);
                    total += price * qty;
                    selectedItems.push({
                        index: parseInt(cb.dataset.index),
                        price: price,
                        qty: qty
                    });
                }
            });
            
            if (selectedItems.length === 0) {
                const alertManager = new ModalManager();
                alertManager.alert({
                    type: 'error',
                    title: 'No Items Selected',
                    message: 'Please select at least one item to refund'
                });
                return;
            }
            
            refundAmount = total;
            endpoint = '<?= $adminPath ?>/api/orders/partial-refund';
            requestData.amount = refundAmount;
            requestData.items = selectedItems;
        }
        
        try {
            const response = await fetch(endpoint, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(requestData)
            });
            
            const responseText = await response.text();
            console.log('Refund response status:', response.status);
            console.log('Refund response text:', responseText);
            
            let result;
            try {
                result = JSON.parse(responseText);
            } catch (e) {
                console.error('Failed to parse JSON:', e);
                console.error('Response was:', responseText.substring(0, 500));
                throw new Error('Server returned invalid response. Check console for details.');
            }
            
            modalManager.hideModal(modal);
            modal.remove();
            
            if (result.success) {
                window.location.reload();
            } else {
                const alertManager = new ModalManager();
                alertManager.alert({
                    type: 'error',
                    title: 'Error',
                    message: 'Failed to process refund: ' + (result.message || 'Unknown error')
                });
            }
        } catch (error) {
            console.error('Error processing refund:', error);
            modalManager.hideModal(modal);
            modal.remove();
            
            const alertManager = new ModalManager();
            alertManager.alert({
                type: 'error',
                title: 'Error',
                message: 'Failed to process refund: ' + error.message
            });
        }
    });
    
    cancelBtn.addEventListener('click', () => {
        modalManager.hideModal(modal);
        modal.remove();
    });
    
    modalManager.showModal(modal);
}
</script>
