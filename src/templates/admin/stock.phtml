<script>
// Track if there are unsaved changes
let hasUnsavedChanges = false;

// Track changes to stock inputs
function adjustStockInput(sku, delta) {
    const input = document.getElementById('stock_' + sku);
    if (input) {
        const currentValue = parseInt(input.value) || 0;
        input.value = currentValue + delta;
        markAsChanged();
    }
}

// Mark form as changed
function markAsChanged() {
    hasUnsavedChanges = true;
}

// Initialize change tracking
document.addEventListener('DOMContentLoaded', function() {
    // Track all stock adjustment inputs
    const stockInputs = document.querySelectorAll('input[name^="stock_updates"]');
    stockInputs.forEach(input => {
        input.addEventListener('change', markAsChanged);
        input.addEventListener('input', markAsChanged);
    });
    
    // Track reason selects
    const reasonSelects = document.querySelectorAll('select[name^="stock_updates"]');
    reasonSelects.forEach(select => {
        select.addEventListener('change', markAsChanged);
    });
    
    // Handle form submission - clear the flag
    const form = document.querySelector('form[method="POST"]');
    if (form) {
        form.addEventListener('submit', function() {
            hasUnsavedChanges = false;
        });
    }
    
    // Intercept pagination and navigation links
    const navigationLinks = document.querySelectorAll('a[href*="page="], a[href*="search="], a[href="?"]');
    navigationLinks.forEach(link => {
        link.addEventListener('click', function(e) {
            if (hasUnsavedChanges) {
                e.preventDefault();
                showUnsavedChangesModal(this.href);
            }
        });
    });
    
    // Warn before leaving page
    window.addEventListener('beforeunload', function(e) {
        if (hasUnsavedChanges) {
            e.preventDefault();
            e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
            return e.returnValue;
        }
    });
});

// Show custom modal for unsaved changes
function showUnsavedChangesModal(targetUrl) {
    // Create modal HTML
    const modalHtml = `
        <div id="unsaved-changes-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 z-50 flex items-center justify-center">
            <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
                <div class="px-6 py-4 border-b border-gray-200">
                    <div class="flex items-center justify-between">
                        <h3 class="text-lg font-medium text-gray-900">
                            <i class="fas fa-exclamation-triangle text-yellow-500 mr-2"></i>
                            Unsaved Changes
                        </h3>
                    </div>
                </div>
                <div class="px-6 py-4">
                    <p class="text-gray-700 mb-4">
                        You have unsaved stock changes. If you leave this page, your changes will be lost.
                    </p>
                    <p class="text-gray-600 text-sm">
                        Would you like to save your changes before continuing?
                    </p>
                </div>
                <div class="px-6 py-4 bg-gray-50 rounded-b-lg flex justify-end space-x-3">
                    <button onclick="closeUnsavedChangesModal()" 
                            class="px-4 py-2 bg-gray-300 text-gray-700 rounded hover:bg-gray-400 transition-colors">
                        <i class="fas fa-times mr-2"></i>Cancel
                    </button>
                    <button onclick="discardChanges('${targetUrl}')" 
                            class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 transition-colors">
                        <i class="fas fa-trash mr-2"></i>Discard Changes
                    </button>
                    <button onclick="saveChanges()" 
                            class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors">
                        <i class="fas fa-save mr-2"></i>Save Changes
                    </button>
                </div>
            </div>
        </div>
    `;
    
    // Add modal to page
    document.body.insertAdjacentHTML('beforeend', modalHtml);
}

// Close the modal
function closeUnsavedChangesModal() {
    const modal = document.getElementById('unsaved-changes-modal');
    if (modal) {
        modal.remove();
    }
}

// Discard changes and navigate
function discardChanges(targetUrl) {
    hasUnsavedChanges = false;
    closeUnsavedChangesModal();
    window.location.href = targetUrl;
}

// Save changes
function saveChanges() {
    const form = document.querySelector('form[method="POST"]');
    if (form) {
        hasUnsavedChanges = false;
        closeUnsavedChangesModal();
        form.submit();
    }
}
</script>
