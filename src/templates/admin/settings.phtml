                                        if (is_array($value)) {
                                            if (array_keys($value) === range(0, count($value) - 1)) {
                                                // It's a list (indexed array)
                                                $itemCount = count($value);
                                                $preview = array_slice($value, 0, 4);
                                                $previewText = implode(', ', array_map('htmlspecialchars', $preview));
                                                if ($itemCount > 4) {
                                                    $previewText .= ', ...';
                                                }
                                                echo '<span class="text-gray-600">' . $itemCount . ' items (' . $previewText . ')</span>';
                                            } else {
                                                // It's a property set (associative array)
                                                echo '<span class="text-gray-600">' . count($value) . ' properties</span>';
                                            }
                                        } else {
                                            echo '<code class="text-xs">' . htmlspecialchars(json_encode($value, JSON_UNESCAPED_SLASHES)) . '</code>';
                                        }
                                    } elseif ($setting['type'] === 'markdown') {
