                                        echo '<span class="inline-flex items-center text-gray-600">';
                                        echo '<i class="fas fa-lock mr-2"></i>';
                                        echo '<span class="font-mono">••••••••</span>';
                                        echo '</span>';
                                    } elseif ($setting['type'] === 'image') {
                                        echo '<img src="' . htmlspecialchars($value) . '" alt="Setting image" class="h-10 w-10 object-cover rounded cursor-pointer hover:opacity-80 transition-opacity" onclick="viewImage(\'' . htmlspecialchars($value, ENT_QUOTES) . '\')" title="Click to view full size">';
