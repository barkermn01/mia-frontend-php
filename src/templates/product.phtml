<script>
// Enhanced variant handling functions
function updateVariantInfo(selectElement) {
    // Let product.js handle everything including stock, price, and attributes
    if (window.ProductPage && window.ProductPage.updateVariantInfo) {
        window.ProductPage.updateVariantInfo(selectElement);
    }
    
    // Update attributes display (this is still handled here)
    const selectedOption = selectElement.options[selectElement.selectedIndex];
    const attributesData = JSON.parse(selectedOption.getAttribute('data-attributes') || '{}');
    updateAttributesDisplay(attributesData);
}

function updateAttributesDisplay(attributesData) {
    const attributesElement = document.getElementById('variant-attributes');
    if (attributesElement) {
        let attributesHtml = '';
        
        for (const [key, value] of Object.entries(attributesData)) {
            attributesHtml += `
                <div class="flex items-center space-x-2 text-sm">
                    <span class="font-medium text-gray-600">${key.charAt(0).toUpperCase() + key.slice(1)}:</span>
                    <span class="text-gray-900">${value}</span>
                </div>
            `;
        }
        
        attributesElement.innerHTML = attributesHtml;
    }
}

// Set VAT rate in config
window.MiaStoreConfig = window.MiaStoreConfig || {};
window.MiaStoreConfig.vatRate = <?= $vatRate ?? 0.20 ?>;

// Initialize variant display on page load
document.addEventListener('DOMContentLoaded', function() {
    // Let product.js handle initialization
    const variantSelect = document.getElementById('variant-select');
    if (variantSelect) {
        // Only update attributes, product.js handles stock and price
        const selectedOption = variantSelect.options[variantSelect.selectedIndex];
        const attributesData = JSON.parse(selectedOption.getAttribute('data-attributes') || '{}');
        updateAttributesDisplay(attributesData);
    }
});

// Existing functions (changeQuantity, addToCartFromProduct, etc.) remain the same
function changeQuantity(delta) {
    const quantityInput = document.getElementById('quantity');
    const currentValue = parseInt(quantityInput.value) || 1;
    const newValue = Math.max(1, Math.min(10, currentValue + delta));
    quantityInput.value = newValue;
}

function changeMainImage(imageUrl) {
    const mainImage = document.getElementById('main-image');
    if (mainImage) {
        mainImage.src = imageUrl;
    }
}

function addToCartFromProduct() {
    const variantSelect = document.getElementById('variant-select');
    const singleVariantSku = document.getElementById('single-variant-sku');
    const quantityInput = document.getElementById('quantity');
    
    let sku = '';
    if (variantSelect) {
        sku = variantSelect.value;
    } else if (singleVariantSku) {
        sku = singleVariantSku.value;
    }
    
    const quantity = parseInt(quantityInput.value) || 1;
    
    if (!sku) {
        alert('Please select a variant');
        return;
    }
    
    // Call the existing addToCart function from the main layout
    if (typeof addToCart === 'function') {
        addToCart(sku, quantity);
    } else {
        console.error('addToCart function not found');
    }
}
</script>