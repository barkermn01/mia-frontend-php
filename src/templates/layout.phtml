    <script>
        // Configuration for the JavaScript app
        window.MiaStoreConfig = {
            cartCount: <?= $cartCount ?>,
            isLoggedIn: <?= $isLoggedIn ? 'true' : 'false' ?><?php if (isset($jsConfig)): ?>,
