<script>
function viewOrderDetails(orderId) {
    // In a real implementation, this would open a detailed order view
    window.location.href = `/orders/${orderId}`;
}

async function reorderItems(orderId) {
    try {
        const response = await MiaStore.request('/api/orders/reorder', {
            method: 'POST',
            body: JSON.stringify({ orderId })
        });
        
        if (response.success) {
            MiaStore.showToast('Items added to cart!');
            MiaStore.updateCartCount(response.cartCount);
        } else {
            MiaStore.showToast(response.message || 'Failed to reorder items', 'error');
        }
    } catch (error) {
        console.error('Reorder error:', error);
        MiaStore.showToast('Failed to reorder items', 'error');
    }
}

function trackOrder(orderId) {
    // In a real implementation, this would open order tracking
    MiaStore.showToast('Order tracking feature coming soon!');
}
</script>