<script>
/**
 * Product Filters JavaScript
 * Handles collapsible filter groups with localStorage persistence
 */
class ProductFilters {
    constructor() {
        this.storageKey = 'mia-store-expanded-filters';
        this.expandedFilters = this.loadExpandedFilters();
        this.init();
    }

    init() {
        // Initialize filter groups based on localStorage
        this.initializeFilterGroups();
    }

    loadExpandedFilters() {
        try {
            const stored = localStorage.getItem(this.storageKey);
            return stored ? JSON.parse(stored) : [];
        } catch (e) {
            console.warn('Failed to load expanded filters from localStorage:', e);
            return [];
        }
    }

    saveExpandedFilters() {
        try {
            localStorage.setItem(this.storageKey, JSON.stringify(this.expandedFilters));
        } catch (e) {
            console.warn('Failed to save expanded filters to localStorage:', e);
        }
    }

    initializeFilterGroups() {
        const filterGroups = document.querySelectorAll('.filter-group');
        
        filterGroups.forEach(group => {
            const filterKey = group.dataset.filterKey;
            const content = group.querySelector('.filter-content');
            const icon = group.querySelector('.filter-icon');
            
            if (this.expandedFilters.includes(filterKey)) {
                this.showFilterGroup(content, icon);
            } else {
                this.hideFilterGroup(content, icon);
            }
        });
    }

    toggleFilterGroup(filterKey) {
        const group = document.querySelector(`[data-filter-key="${filterKey}"]`);
        if (!group) return;

        const content = group.querySelector('.filter-content');
        const icon = group.querySelector('.filter-icon');
        
        if (this.expandedFilters.includes(filterKey)) {
            // Collapse
            this.expandedFilters = this.expandedFilters.filter(key => key !== filterKey);
            this.hideFilterGroup(content, icon);
        } else {
            // Expand
            this.expandedFilters.push(filterKey);
            this.showFilterGroup(content, icon);
        }
        
        this.saveExpandedFilters();
    }

    showFilterGroup(content, icon) {
        content.style.display = 'block';
        icon.style.transform = 'rotate(180deg)';
    }

    hideFilterGroup(content, icon) {
        content.style.display = 'none';
        icon.style.transform = 'rotate(0deg)';
    }
}

// Global function for onclick handlers
function toggleFilterGroup(filterKey) {
    if (window.productFilters) {
        window.productFilters.toggleFilterGroup(filterKey);
    }
}

// Initialize when DOM is loaded
document.addEventListener('DOMContentLoaded', function() {
    window.productFilters = new ProductFilters();
});
</script>