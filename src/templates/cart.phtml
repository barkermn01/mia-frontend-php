    <?php 
    // Get VAT rate (as decimal, e.g., 0.20 for 20%)
    $vatRate = $vatRate ?? 0.20;
    
    // Calculate totals with proper per-item VAT rounding
    $subtotalExVat = 0;
    $totalVat = 0;
    
    foreach ($cart['items'] as &$item) {
        // Get price in pence (ex-VAT)
        $priceExVat = is_array($item['price']) ? ($item['price'][0]['unit'] ?? $item['price']['unit'] ?? 0) : $item['price'];
        
        // Calculate VAT per item and round
        $itemVat = round($priceExVat * $vatRate);
        $priceIncVat = $priceExVat + $itemVat;
        
        // Store calculated values on item for display
        $item['priceExVat'] = $priceExVat;
        $item['priceIncVat'] = $priceIncVat;
        $item['itemVat'] = $itemVat;
        
        // Calculate line totals
        $lineExVat = $priceExVat * $item['qty'];
        $lineVat = $itemVat * $item['qty'];
        
        $subtotalExVat += $lineExVat;
        $totalVat += $lineVat;
    }
    unset($item); // Break reference
    
    $selectedShippingMethod = null;
    $shippingCost = 0;
    
    if ($shippingOptions && !empty($shippingOptions['methods'])) {
        $selectedShippingMethod = $shippingOptions['methods'][0];
        $shippingCost = $selectedShippingMethod['cost'];
    }
    
    $total = $subtotalExVat + $totalVat + $shippingCost;
